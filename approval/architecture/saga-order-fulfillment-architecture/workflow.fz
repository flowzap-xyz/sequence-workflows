OrderSaga { # Order Fulfillment Saga
n1: circle label:"Order Received"
n2: rectangle label:"Validate Order"
n3: rectangle label:"Step 1: Verify Customer"
n8: rectangle label:"Step 2: Check Inventory"
n13: rectangle label:"Step 3: Authorize Payment"
n18: rectangle label:"Step 4: Ship Order"
n23: diamond label:"Saga Complete?"
n24: rectangle label:"Finalize Order"
n25: rectangle label:"Trigger Compensation Chain"
n26: circle label:"Order Fulfilled"
n32: rectangle label:"Rollback Confirmed"
n1.handle(right) -> n2.handle(left)
n2.handle(right) -> n3.handle(left) [label="Valid"]
n3.handle(bottom) -> Services.n4.handle(top) [label="Verify"]
n8.handle(bottom) -> Services.n9.handle(top) [label="Reserve"]
n13.handle(bottom) -> Services.n14.handle(top) [label="Charge"]
n18.handle(bottom) -> Services.n19.handle(top) [label="Ship"]
n23.handle(right) -> n24.handle(left) [label="Success"]
n23.handle(bottom) -> n25.handle(top) [label="Failure"]
n24.handle(right) -> n26.handle(left)
n25.handle(bottom) -> Compensations.n27.handle(top) [label="Compensate"]
n32.handle(right) -> n26.handle(left)
}
Services { # Participating Services
n4: rectangle label:"Customer Service"
n5: rectangle label:"Verify Customer"
n6: rectangle label:"Send Verification"
n7: rectangle label:"Forward to Saga"
n9: rectangle label:"Inventory Service"
n10: rectangle label:"Reserve Stock"
n11: rectangle label:"Send Reservation"
n12: rectangle label:"Forward to Saga"
n14: rectangle label:"Payment Service"
n15: rectangle label:"Charge Payment"
n16: rectangle label:"Send Charge Result"
n17: rectangle label:"Forward to Saga"
n19: rectangle label:"Shipping Service"
n20: rectangle label:"Ship Order"
n21: rectangle label:"Send Shipment Status"
n22: rectangle label:"Forward to Saga"
n4.handle(right) -> n5.handle(left)
n5.handle(right) -> n6.handle(left)
n6.handle(right) -> n7.handle(left)
n7.handle(top) -> OrderSaga.n8.handle(bottom) [label="Customer OK"]
n9.handle(right) -> n10.handle(left)
n10.handle(right) -> n11.handle(left)
n11.handle(right) -> n12.handle(left)
n12.handle(top) -> OrderSaga.n13.handle(bottom) [label="Reserved"]
n14.handle(right) -> n15.handle(left)
n15.handle(right) -> n16.handle(left)
n16.handle(right) -> n17.handle(left)
n17.handle(top) -> OrderSaga.n18.handle(bottom) [label="Charged"]
n19.handle(right) -> n20.handle(left)
n20.handle(right) -> n21.handle(left)
n21.handle(right) -> n22.handle(left)
n22.handle(top) -> OrderSaga.n23.handle(bottom) [label="Shipped"]
}
Compensations { # Compensation Actions
n27: rectangle label:"Reverse Payment"
n28: rectangle label:"Release Inventory"
n29: rectangle label:"Notify Customer"
n30: rectangle label:"Notify Saga"
n31: rectangle label:"Send Rollback Status"
n27.handle(right) -> n28.handle(left) [label="Refund"]
n28.handle(right) -> n29.handle(left) [label="Unreserve"]
n29.handle(right) -> n30.handle(left) [label="Apology Email"]
n30.handle(right) -> n31.handle(left)
n31.handle(top) -> OrderSaga.n32.handle(bottom) [label="Rollback Complete"]
}
