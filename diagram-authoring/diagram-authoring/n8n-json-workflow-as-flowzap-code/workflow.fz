N8n { # N8n
  n2: circle label:"Manual Trigger"
  n3: rectangle label:"Spreadsheet File: Read Rows"
  n4: rectangle label:"Split In Batches: Iterate Items"
  n5: rectangle label:"Set: Map Fields"
  n6: rectangle label:"HTTP Request: Generate PDF"
  n1: diamond label:"IF"
  n7: rectangle label:"Gmail: Send Email"
  n8: diamond label:"IF"
  n9: rectangle label:"Set: Log Success"
  n10: circle label:"Set: End"
  n11: rectangle label:"Set: Log Error"
  n2.handle(right) -> n3.handle(left)
  n3.handle(right) -> n4.handle(left)
  n4.handle(right) -> n5.handle(left)
  n5.handle(right) -> n6.handle(left)
  n6.handle(right) -> n1.handle(left)
  n1.handle(right) -> n7.handle(left) [label="Yes"]
  n7.handle(right) -> n8.handle(left)
  n8.handle(right) -> n9.handle(left) [label="Yes"]
  n8.handle(bottom) -> n11.handle(bottom) [label="No"]
  n9.handle(right) -> n10.handle(left)
  n1.handle(top) -> n11.handle(top) [label="No"]
  n11.handle(left) -> n10.handle(right)
}
