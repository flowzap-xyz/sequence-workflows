laneA { # Lanea
  n1: circle label:"Start 01 Basic Lane"
  n2: rectangle label:"01 Basic Lane step 2"
  n3: rectangle label:"01 Basic Lane step 3"
  n4: rectangle label:"01 Basic Lane step 4"
  n5: circle label:"End 01 Basic Lane"

  n1.handle(right) -> n2.handle(left)
  n2.handle(right) -> n3.handle(left)
  n3.handle(right) -> n4.handle(left)
  n4.handle(right) -> n5.handle(left)
}