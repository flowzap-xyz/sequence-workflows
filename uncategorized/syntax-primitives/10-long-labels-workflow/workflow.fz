laneA { # Lane A
  n1: circle label:"Start 10 Long Labels"
  n2: rectangle label:"10 Long Labels step 2"
  n3: rectangle label:"10 Long Labels step 3"
  n4: rectangle label:"10 Long Labels step 4"
  n5: circle label:"End 10 Long Labels"

  n1.handle(right) -> n2.handle(left)
  n2.handle(right) -> n3.handle(left)
  n3.handle(right) -> n4.handle(left)
  n4.handle(right) -> n5.handle(left)
}