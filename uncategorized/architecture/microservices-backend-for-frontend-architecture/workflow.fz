WebApp { # Web Application
n1: circle label:"Browser Request"
n2: rectangle label:"Web BFF"
n15: rectangle label:"Render HTML Response"
n16: circle label:"Display Page"
n1.handle(right) -> n2.handle(left)
n2.handle(bottom) -> Services.n5.handle(top) [label="Fetch Data"]
n15.handle(right) -> n16.handle(left)
}
MobileApp { # Mobile Application
n3: circle label:"Mobile API Call"
n4: rectangle label:"Mobile BFF"
n17: rectangle label:"Optimized Payload"
n18: circle label:"Render Native UI"
n3.handle(right) -> n4.handle(left)
n4.handle(bottom) -> Services.n5.handle(top) [label="Fetch Data"]
n17.handle(right) -> n18.handle(left)
}
Services { # Shared Microservices
n5: rectangle label:"User Profile Service"
n6: rectangle label:"Content Service"
n7: rectangle label:"Notification Service"
n8: rectangle label:"Analytics Service"
n9: rectangle label:"Prepare Web Payload"
n10: rectangle label:"Prepare Mobile Payload"
n11: rectangle label:"Send Web Response"
n12: rectangle label:"Send Mobile Response"
n13: rectangle label:"Send Push Notification"
n14: rectangle label:"Log Analytics"
n5.handle(right) -> n6.handle(left) [label="User Context"]
n6.handle(right) -> n7.handle(left)
n7.handle(right) -> n8.handle(left)
n8.handle(right) -> n9.handle(left)
n9.handle(right) -> n10.handle(left)
n10.handle(right) -> n11.handle(left)
n11.handle(top) -> WebApp.n15.handle(bottom) [label="Full Payload"]
n11.handle(right) -> n12.handle(left)
n12.handle(top) -> MobileApp.n17.handle(bottom) [label="Compact Payload"]
n12.handle(right) -> n13.handle(left)
n13.handle(right) -> n14.handle(left) [label="Push + Track"]
}
