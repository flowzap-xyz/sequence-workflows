user { # User
  n1: circle label:"Start Content Enricher"
  n2: diamond label:"Receive Content Enricher event"
  n4: rectangle label:"Execute Content Enricher action"
  n7: rectangle label:"Monitor Content Enricher status"
  n10: circle label:"End Content Enricher"
  n1.handle(right) -> n2.handle(left)
  n4.handle(bottom) -> app.n5.handle(top)
  n7.handle(bottom) -> app.n8.handle(top)
  n2.handle(top) -> n4.handle(top) [label="No/Rejected"]
  n2.handle(bottom) -> service.n3.handle(top) [label="Yes/Approved"]
}

app { # App
  n5: rectangle label:"Record Content Enricher outcome"
  n8: rectangle label:"Monitor Content Enricher status"
  n5.handle(bottom) -> service.n6.handle(top)
  n8.handle(bottom) -> service.n9.handle(top)
}

service { # Service
  n3: rectangle label:"Validate Content Enricher conditions"
  n6: rectangle label:"Monitor Content Enricher status"
  n9: rectangle label:"Monitor Content Enricher status"
  n9.handle(right) -> user.n10.handle(bottom)
  n6.handle(right) -> user.n7.handle(left)
  n3.handle(left) -> app.n5.handle(left)
}
