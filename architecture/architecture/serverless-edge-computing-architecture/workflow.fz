User { # End User
n1: circle label:"Browser Request"
n2: rectangle label:"DNS Resolution (Route 53)"
n21: rectangle label:"Receive Optimized Response"
n22: circle label:"Page Rendered"
n1.handle(right) -> n2.handle(left)
n2.handle(bottom) -> Edge.n3.handle(top) [label="Nearest PoP"]
n21.handle(right) -> n22.handle(left)
}
Edge { # Edge Network (CloudFront/Cloudflare)
n3: rectangle label:"Edge Location PoP"
n4: diamond label:"Cache Hit?"
n5: rectangle label:"Return Cached Response"
n6: rectangle label:"Edge Function (Lambda@Edge)"
n7: rectangle label:"A/B Test Routing"
n8: rectangle label:"Geo-Based Personalization"
n19: rectangle label:"Cache and Forward Response"
n20: rectangle label:"Send to User"
n3.handle(right) -> n4.handle(left)
n4.handle(right) -> n5.handle(left) [label="HIT"]
n4.handle(bottom) -> n6.handle(top) [label="MISS"]
n5.handle(top) -> User.n21.handle(bottom) [label="Fast Response"]
n6.handle(right) -> n7.handle(left) [label="Modify Request"]
n7.handle(right) -> n8.handle(left) [label="Personalize"]
n8.handle(bottom) -> Origin.n9.handle(top) [label="Forward"]
n19.handle(right) -> n20.handle(left)
n20.handle(top) -> User.n21.handle(bottom) [label="Response"]
}
Origin { # Origin Services
n9: rectangle label:"Origin Shield"
n10: rectangle label:"Application Load Balancer"
n11: rectangle label:"Serverless API"
n12: rectangle label:"Static Asset Store (S3)"
n13: rectangle label:"Generate Response"
n14: rectangle label:"Prepare Origin Response"
n15: rectangle label:"Package Response"
n16: rectangle label:"Forward Origin Response"
n17: rectangle label:"Send Cached Response"
n18: rectangle label:"Deliver to Edge"
n9.handle(right) -> n10.handle(left) [label="Collapse Requests"]
n10.handle(right) -> n11.handle(left) [label="Dynamic"]
n10.handle(bottom) -> n12.handle(top) [label="Static"]
n11.handle(right) -> n13.handle(left) [label="Compute"]
n12.handle(right) -> n13.handle(left) [label="Assets"]
n13.handle(right) -> n14.handle(left)
n14.handle(right) -> n15.handle(left)
n15.handle(right) -> n16.handle(left)
n16.handle(right) -> n17.handle(left)
n17.handle(right) -> n18.handle(left)
n18.handle(top) -> Edge.n19.handle(bottom) [label="Cache + Return"]
}
