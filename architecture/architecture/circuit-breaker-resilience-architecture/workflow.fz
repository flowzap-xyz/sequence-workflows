Client { # Client Service
n1: circle label:"Service Call"
n2: rectangle label:"Circuit Breaker Proxy"
n21: rectangle label:"Receive Response"
n22: circle label:"End"
n1.handle(right) -> n2.handle(left)
n2.handle(bottom) -> Breaker.n3.handle(top) [label="Check State"]
n21.handle(right) -> n22.handle(left)
}
Breaker { # Circuit Breaker
n3: diamond label:"Circuit State?"
n4: rectangle label:"Forward Request (Closed)"
n5: rectangle label:"Return Fallback (Open)"
n6: rectangle label:"Test Request (Half-Open)"
n13: rectangle label:"Track Success"
n14: rectangle label:"Track Failure"
n15: diamond label:"Failure Threshold?"
n16: rectangle label:"Trip Circuit Open"
n17: rectangle label:"Reset to Closed"
n18: rectangle label:"Start Recovery Timer"
n19: rectangle label:"Forward Success Response"
n20: rectangle label:"Forward Error Response"
n3.handle(right) -> n4.handle(left) [label="Closed"]
n3.handle(bottom) -> n5.handle(top) [label="Open"]
n3.handle(left) -> n6.handle(right) [label="Half-Open"]
n4.handle(bottom) -> Downstream.n7.handle(top) [label="Forward"]
n5.handle(top) -> Client.n21.handle(bottom) [label="Cached/Default"]
n6.handle(bottom) -> Downstream.n7.handle(top) [label="Probe"]
n13.handle(right) -> n17.handle(left) [label="Healthy"]
n14.handle(right) -> n15.handle(left)
n15.handle(right) -> n16.handle(left) [label="Exceeded"]
n16.handle(right) -> n18.handle(left) [label="Cooldown"]
n17.handle(right) -> n19.handle(left)
n19.handle(top) -> Client.n21.handle(bottom) [label="Success"]
n18.handle(right) -> n20.handle(left)
n20.handle(top) -> Client.n21.handle(bottom) [label="Error"]
}
Downstream { # Downstream Service
n7: rectangle label:"Process Request"
n8: diamond label:"Response OK?"
n9: rectangle label:"Return Success"
n10: rectangle label:"Return Error/Timeout"
n11: rectangle label:"Send Success Signal"
n12: rectangle label:"Send Failure Signal"
n7.handle(right) -> n8.handle(left)
n8.handle(right) -> n9.handle(left) [label="200"]
n8.handle(bottom) -> n10.handle(top) [label="5xx/Timeout"]
n9.handle(right) -> n11.handle(left)
n10.handle(right) -> n12.handle(left)
n11.handle(top) -> Breaker.n13.handle(bottom) [label="Success"]
n12.handle(top) -> Breaker.n14.handle(bottom) [label="Failure"]
}
