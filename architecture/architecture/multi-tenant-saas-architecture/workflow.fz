Tenant { # Tenant Request
n1: circle label:"Tenant API Call"
n2: rectangle label:"Tenant Identification"
n20: rectangle label:"Receive Response"
n21: circle label:"End"
n1.handle(right) -> n2.handle(left) [label="X-Tenant-ID"]
n2.handle(bottom) -> Routing.n3.handle(top) [label="Resolve Tenant"]
n20.handle(right) -> n21.handle(left)
}
Routing { # Tenant Routing Layer
n3: rectangle label:"Tenant Config Lookup"
n4: diamond label:"Isolation Model?"
n5: rectangle label:"Route to Shared Pool"
n6: rectangle label:"Route to Dedicated Pool"
n7: rectangle label:"Apply Tenant Rate Limits"
n18: rectangle label:"Receive App Response"
n19: rectangle label:"Forward to Tenant"
n3.handle(right) -> n4.handle(left) [label="Tier"]
n4.handle(right) -> n5.handle(left) [label="Standard Tier"]
n4.handle(bottom) -> n6.handle(top) [label="Enterprise Tier"]
n5.handle(right) -> n7.handle(left)
n6.handle(right) -> n7.handle(left)
n7.handle(bottom) -> Application.n8.handle(top) [label="Tenant Context"]
n18.handle(right) -> n19.handle(left)
n19.handle(top) -> Tenant.n20.handle(bottom) [label="Response"]
}
Application { # Application Layer
n8: rectangle label:"Inject Tenant Context"
n9: rectangle label:"Execute Business Logic"
n10: rectangle label:"Apply Row-Level Security"
n15: rectangle label:"Receive Query Results"
n16: rectangle label:"Return Tenant-Scoped Data"
n17: rectangle label:"Forward to Routing"
n8.handle(right) -> n9.handle(left) [label="Middleware"]
n9.handle(right) -> n10.handle(left) [label="Query"]
n10.handle(bottom) -> DataLayer.n11.handle(top) [label="Tenant Filter"]
n15.handle(right) -> n16.handle(left) [label="Filtered"]
n16.handle(right) -> n17.handle(left)
n17.handle(top) -> Routing.n18.handle(bottom) [label="App Response"]
}
DataLayer { # Data Isolation
n11: rectangle label:"Shared Database (Schema per Tenant)"
n12: rectangle label:"Dedicated Database (Enterprise)"
n13: rectangle label:"Tenant Encryption Keys"
n14: rectangle label:"Return Query Results"
n11.handle(right) -> n13.handle(left) [label="Encrypt at Rest"]
n12.handle(right) -> n13.handle(left) [label="Dedicated Key"]
n13.handle(right) -> n14.handle(left)
n14.handle(top) -> Application.n15.handle(bottom) [label="Data Results"]
}
