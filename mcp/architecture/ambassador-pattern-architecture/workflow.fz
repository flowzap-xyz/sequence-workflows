Application { # Application Container
n1: circle label:"Outbound Request"
n2: rectangle label:"Application Code"
n3: rectangle label:"Ambassador Proxy"
n14: rectangle label:"Receive Proxied Response"
n15: circle label:"End"
n1.handle(right) -> n2.handle(left)
n2.handle(right) -> n3.handle(left) [label="localhost:9000"]
n3.handle(bottom) -> AmbassadorLogic.n4.handle(top) [label="Intercept"]
n14.handle(right) -> n15.handle(left)
}
AmbassadorLogic { # Ambassador Logic
n4: rectangle label:"Add Auth Headers"
n5: rectangle label:"Apply Circuit Breaker"
n6: diamond label:"Circuit Open?"
n7: rectangle label:"Enable Retry Logic"
n8: rectangle label:"Return Cached Fallback"
n12: rectangle label:"Collect Metrics"
n13: rectangle label:"Forward Response"
n4.handle(right) -> n5.handle(left) [label="Bearer Token"]
n5.handle(right) -> n6.handle(left)
n6.handle(right) -> n7.handle(left) [label="Closed"]
n6.handle(bottom) -> n8.handle(top) [label="Open"]
n7.handle(bottom) -> ExternalService.n9.handle(top) [label="HTTPS + Retry"]
n8.handle(top) -> Application.n14.handle(bottom) [label="Fallback"]
n12.handle(right) -> n13.handle(left)
n13.handle(top) -> Application.n14.handle(bottom) [label="Proxied Response"]
}
ExternalService { # External API
n9: rectangle label:"Third-Party API"
n10: rectangle label:"Process Request"
n11: rectangle label:"Return Response"
n9.handle(right) -> n10.handle(left)
n10.handle(right) -> n11.handle(left)
n11.handle(top) -> AmbassadorLogic.n12.handle(bottom) [label="Response + Metrics"]
}
