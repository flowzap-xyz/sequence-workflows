Coordinator { # Transaction Coordinator
n1: circle label:"Begin Distributed Transaction"
n2: rectangle label:"Assign Transaction ID"
n3: rectangle label:"Send Prepare to All"
n16: rectangle label:"Collect Votes"
n17: diamond label:"All Voted Commit?"
n18: rectangle label:"Send Global Commit"
n19: rectangle label:"Send Global Abort"
n20: circle label:"Transaction Complete"
n1.handle(right) -> n2.handle(left)
n2.handle(right) -> n3.handle(left) [label="TxID"]
n3.handle(bottom) -> ServiceA.n4.handle(top) [label="Prepare"]
n3.handle(bottom) -> ServiceB.n7.handle(top) [label="Prepare"]
n3.handle(bottom) -> ServiceC.n10.handle(top) [label="Prepare"]
n16.handle(right) -> n17.handle(left)
n17.handle(right) -> n18.handle(left) [label="Yes"]
n17.handle(bottom) -> n19.handle(top) [label="No"]
n18.handle(right) -> n20.handle(left)
n19.handle(right) -> n20.handle(left) [label="Rolled Back"]
}
ServiceA { # Booking Service
n4: rectangle label:"Lock Resources"
n5: rectangle label:"Vote Commit"
n6: rectangle label:"Send Vote"
n4.handle(right) -> n5.handle(left) [label="Prepared"]
n5.handle(right) -> n6.handle(left)
n6.handle(top) -> Coordinator.n16.handle(bottom) [label="Vote"]
}
ServiceB { # Payment Service
n7: rectangle label:"Hold Funds"
n8: rectangle label:"Vote Commit"
n9: rectangle label:"Send Vote"
n7.handle(right) -> n8.handle(left) [label="Prepared"]
n8.handle(right) -> n9.handle(left)
n9.handle(top) -> Coordinator.n16.handle(bottom) [label="Vote"]
}
ServiceC { # Notification Service
n10: rectangle label:"Queue Notification"
n11: rectangle label:"Vote Commit"
n12: rectangle label:"Send Vote"
n13: rectangle label:"Apply Changes"
n14: rectangle label:"Capture Payment"
n15: rectangle label:"Send Notification"
n10.handle(right) -> n11.handle(left) [label="Prepared"]
n11.handle(right) -> n12.handle(left)
n12.handle(top) -> Coordinator.n16.handle(bottom) [label="Vote"]
n13.handle(right) -> n14.handle(left)
n14.handle(right) -> n15.handle(left)
}
